{
    "name": "amyla/worlddata",
    "description": "Localized world data and relationships for Laravel, powered by Symfony Intl, Unicode CLDR and IANA.",
    "type": "library",
    "keywords": ["laravel", "countries", "continents", "currencies", "languages", "timezones", "tlds"],
    "require": {
        "php": "^8.3",
        "ext-intl": "*",
        "illuminate/support": "^12.0 || ^13.0",
        "symfony/intl": "^7.4.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Amyla\\Worlddata\\": "src/"
        },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Amyla\\Worlddata\\Build\\": "build/",
            "Amyla\\Worlddata\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Amyla\\Worlddata\\WorlddataServiceProvider"]
        }
    },
    "authors": [{"name": "Amyla", "homepage": "https://amyla.net"}],
    "support": {
        "email": "ns@amyla.net",
        "issues": "https://github.com/amyla-net/worlddata/issues",
        "source": "https://github.com/amyla-net/worlddata"
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "data:update": "@php build/update.php",
        "data:build": "@php build/update.php --offline",
        "check": ["@format:check", "@analyse", "@test"]
    },
    "config": {"sort-packages": true},
    "archive": {
        "exclude": [
            "/vendor", "/.cache", "/tests", "/build", "/.github", "/.git",
            "/.idea", "/.agents", "/.codex", "/.aws", "/workbench",
            "/composer.lock", "/phpunit.xml.dist", "/phpstan.neon",
            "/.editorconfig", "/.gitignore", "/.gitattributes"
        ]
    }
}
